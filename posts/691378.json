  "content": "<h1>heading 1</h1><div><pre><font color=\"#cccccc\" face=\"Consolas, Monaco, Andale Mono, Ubuntu Mono, monospace\">#include &lt;iostream&gt;\nusing namespace std;\n\nint main() {\n    long long num;\n    int sum = 0;\n\n    cout &lt;&lt; \"Enter a number: \";\n    cin &gt;&gt; num;\n\n    // Handle negative numbers by taking the absolute value\n    if (num &lt; 0) num = -num;\n\n    while (num &gt; 0) {\n        sum += num % 10;  // Get the last digit\n        num /= 10;        // Remove the last digit\n    }\n\n    cout &lt;&lt; \"Sum of digits: \" &lt;&lt; sum &lt;&lt; endl;\n    return 0;\n}\n</font><span class=\"code-lang-badge\">CPP</span></pre><p><h2>heading 2</h2><p><blockquote><p>Hi<br></p></blockquote><p><h3>heading 3</h3><p><span class=\"ghost-inline\"><svg width=\"56\" height=\"64\" viewBox=\"0 0 72 82\" class=\"nv-ghost-svg\"><ellipse cx=\"36\" cy=\"32\" rx=\"25\" ry=\"27\" fill=\"#9090b8\"></ellipse><path d=\"M11 32 Q11 60 18 60 Q22 60 22 56 Q22 60 27 60 Q32 60 32 56 Q32 60 36 60 Q40 60 40 56 Q40 60 45 60 Q50 60 50 56 Q50 60 54 60 Q61 60 61 32 Z\" fill=\"#9090b8\"></path><circle cx=\"28\" cy=\"30\" r=\"5\" fill=\"#06080f\" opacity=\"0.6\"></circle><circle cx=\"44\" cy=\"30\" r=\"5\" fill=\"#06080f\" opacity=\"0.6\"></circle><line x1=\"26\" y1=\"44\" x2=\"46\" y2=\"44\" stroke=\"#06080f\" stroke-width=\"1.5\"></line><line x1=\"30\" y1=\"44\" x2=\"30\" y2=\"50\" stroke=\"#06080f\" stroke-width=\"1.5\"></line><line x1=\"36\" y1=\"44\" x2=\"36\" y2=\"50\" stroke=\"#06080f\" stroke-width=\"1.5\"></line><line x1=\"42\" y1=\"44\" x2=\"42\" y2=\"50\" stroke=\"#06080f\" stroke-width=\"1.5\"></line></svg></span><br></p><p><h4>heading 4</h4><p><table style=\"width: 100%; border-collapse: collapse;\"><thead><tr><th contenteditable=\"true\">Col 1</th><th contenteditable=\"true\">Col 2</th><th contenteditable=\"true\">Col 3</th></tr></thead><tbody><tr><td contenteditable=\"true\">cell</td><td contenteditable=\"true\">cell</td><td contenteditable=\"true\